# The folder on this computer where OST Planner keeps your projects, images and backups.
# Docker can only reach folders listed here. Use a full path, for example:
#   Mac:     OST_DATA_DIR=/Users/yourname/Documents/OST Planner
#   Windows: OST_DATA_DIR=C:\Users\yourname\Documents\OST Planner
# After changing it, run: docker compose up -d
OST_DATA_DIR=./data
